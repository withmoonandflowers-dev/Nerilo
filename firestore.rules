rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      // 若尚未設定自訂角色（例如匿名使用者），預設視為 guest
      return request.auth.token.role != null ? request.auth.token.role : 'guest';
    }

    function isAdmin() {
      return getUserRole() == 'admin';
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // ── meshIdentities 驗證 ──────────────────────────────────────────────
    function isValidMeshIdentity(identity) {
      return identity.userId is string
        && identity.userId.size() >= 8
        && identity.userId.size() <= 64
        && identity.pubKey is string
        && identity.pubKey.size() >= 40
        && identity.pubKey.size() <= 512
        // ecdhPubKey 可選（ADR-0023 P2-②c keyx）；提供時驗格式。
        // 覆寫他人條目已由 meshIdentitiesChangeIsValid（affectedKeys ⊆ {auth.uid}）擋下。
        && (!('ecdhPubKey' in identity) || (
             identity.ecdhPubKey is string
             && identity.ecdhPubKey.size() >= 40
             && identity.ecdhPubKey.size() <= 512))
        // introducedBy 可選（Spec 005 T4 邀請會合）；提供時須為字串（格式同 uid 長度界）。
        && (!('introducedBy' in identity) || (
             identity.introducedBy is string
             && identity.introducedBy.size() >= 1
             && identity.introducedBy.size() <= 128));
    }

    // 任何 update 都只能影響到 meshIdentities[auth.uid] 這個 key。
    // 沒有此檢查時，惡意參與者（甚至房主）可以覆寫他人的 ECDH 公鑰，造成 MITM。
    function meshIdentitiesChangeIsValid() {
      let oldMI = resource.data.get('meshIdentities', {});
      let newMI = request.resource.data.get('meshIdentities', {});
      // affectedKeys() 包含新增、修改、刪除的 key。要求 ⊆ {auth.uid}。
      return newMI.diff(oldMI).affectedKeys().hasOnly([request.auth.uid]);
    }

    // Features collection - 功能註冊表
    match /features/{featureId} {
      // 所有人可讀取 enabled=true 的功能
      allow read: if isAuthenticated();

      // 僅 admin 可寫入
      allow write: if isAdmin();
    }

    // Users collection - 使用者 profile
    // 開發階段簡化規則：只要有登入（包含匿名），即可讀寫自己的 users 文件
    match /users/{uid} {
      allow read, create, update: if isAuthenticated() && isOwner(uid);
      allow delete: if false; // 不允許從前端刪除 user 文件
    }

    // ── 房間人數上限（ADR-0005 第一層：結構性總量限制；Spec 011 Q7 分層） ──
    // 容量屬房主權益：建房時寫入 maxParticipants（Free ≤5、Pro ≤10，
    // 由 request.auth.token.plan 驗證），join 一律對文件上的容量強制。
    // legacy 房無欄位＝5。與 RoomService.roomCapacity/normalizeMaxParticipants 同語義。
    // 有效容量：欄位存在且為 2..10 的整數才採用，否則（legacy/畸形）＝5。
    // 畸形值理論上進不來（create 驗證 + update 不可變），此為縱深防禦。
    function roomCapacity(data) {
      return ('maxParticipants' in data
              && data.maxParticipants is int
              && data.maxParticipants >= 2
              && data.maxParticipants <= 10)
        ? data.maxParticipants
        : 5;
    }

    function participantsWithinCap(data) {
      return data.participants is list
        && data.participants.size() <= roomCapacity(data);
    }

    // 建房時的容量欄位驗證：缺省合法（＝5）；有值必須是 2..10 的整數，
    // 且 >5 需 Pro 方案（token.plan 由 LS webhook 經 firebase-admin 寫入）。
    function validMaxParticipantsOnCreate(data) {
      return !('maxParticipants' in data)
        || (data.maxParticipants is int
            && data.maxParticipants >= 2
            && data.maxParticipants <= 10
            && (data.maxParticipants <= 5
                || ('plan' in request.auth.token && request.auth.token.plan == 'pro')));
    }

    // 更新時容量不可變（房主也不行——變更容量屬未來獨立功能，先鎖死防繞過）
    function maxParticipantsUnchanged() {
      return ('maxParticipants' in request.resource.data
                ? request.resource.data.maxParticipants
                : null)
          == ('maxParticipants' in resource.data
                ? resource.data.maxParticipants
                : null);
    }

    function ownerUidUnchanged() {
      return request.resource.data.ownerUid == resource.data.ownerUid;
    }

    function participantCountMatches(data) {
      return data.participantCount is int
        && data.participantCount == data.participants.size();
    }

    // 新成員只能把「自己」加入既有名冊；不得趁 join 改房主、踢人或改任意 metadata。
    function isSelfJoinOnly() {
      let oldP = resource.data.participants.toSet();
      let newP = request.resource.data.participants.toSet();
      let statusUnchanged = request.resource.data.status == resource.data.status;
      let activatesWaitingRoom = resource.data.status == 'waiting'
        && request.resource.data.status == 'open'
        && request.resource.data.participants.size() >= 2;
      return !(request.auth.uid in resource.data.participants)
        && request.auth.uid in request.resource.data.participants
        && oldP.difference(newP).size() == 0
        && newP.difference(oldP).hasOnly([request.auth.uid])
        && request.resource.data.participants.size() == newP.size()
        && participantCountMatches(request.resource.data)
        && ownerUidUnchanged()
        && (statusUnchanged || activatesWaitingRoom)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['participants', 'participantCount', 'status', 'lastActiveAt', 'ttlExpireAt']);
    }

    // 既有成員可以刷新房間活性，但不能藉此改共享狀態。
    function isParticipantActivityUpdate() {
      return request.auth.uid in resource.data.participants
        && ownerUidUnchanged()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['lastActiveAt', 'ttlExpireAt']);
    }

    // mesh identity 是每位成員自己的安全邊界；topology 只是非安全性的能力提示。
    function isOwnMeshIdentityUpdate() {
      return request.auth.uid in resource.data.participants
        && ownerUidUnchanged()
        && request.resource.data.participants == resource.data.participants
        && 'meshIdentities' in request.resource.data
        && request.auth.uid in request.resource.data.meshIdentities
        && isValidMeshIdentity(request.resource.data.meshIdentities[request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['meshIdentities', 'topology']);
    }

    // 房主仍可管理房間生命週期與產品 metadata，但只能改已知欄位，且一般更新
    // 不得偷換 ownerUid。participants 清空只允許同時關房。
    function isOwnerManagedUpdate() {
      let newP = request.resource.data.participants.toSet();
      return request.auth.uid == resource.data.ownerUid
        && ownerUidUnchanged()
        && request.resource.data.participants.size() == newP.size()
        && (request.auth.uid in request.resource.data.participants
            || (request.resource.data.participants.size() == 0
                && request.resource.data.status == 'closed'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'closedAt', 'participants', 'participantCount',
             'lastActiveAt', 'ttlExpireAt', 'meshIdentities', 'topology', 'version',
             'capabilityHint', 'kind', 'roomName', 'isPrivate', 'ownerName',
             'hostMigrationEpoch', 'previousRoomId', 'lineageRootRoomId'
           ]);
    }

    // 房主移交是唯一可改 ownerUid 的 client 操作：舊房主必須離開、不得新增成員，
    // 新房主必須是更新前後都在房內的既有成員，epoch 恰好 +1。
    function isOwnerMigration() {
      let oldP = resource.data.participants.toSet();
      let newP = request.resource.data.participants.toSet();
      return request.auth.uid == resource.data.ownerUid
        && request.resource.data.ownerUid != resource.data.ownerUid
        && request.resource.data.ownerUid in resource.data.participants
        && request.resource.data.ownerUid in request.resource.data.participants
        && !(request.auth.uid in request.resource.data.participants)
        && newP.difference(oldP).size() == 0
        && request.resource.data.participants.size() == newP.size()
        && request.resource.data.get('hostMigrationEpoch', 0)
             == resource.data.get('hostMigrationEpoch', 0) + 1
        && request.resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'ownerUid', 'status', 'participants', 'participantCount',
             'hostMigrationEpoch', 'previousRoomId', 'lineageRootRoomId'
           ]);
    }

    // Firestore Map.size() 只算欄位數，不是 byte 大小。要真的限制 signaling payload，
    // 必須按 SDP / ICE 的實際字串欄位驗證長度與形狀。
    function isValidSignalPayload(data) {
      return data.payload is map
        && data.keys().hasOnly(
             ['from', 'to', 'type', 'payload', 'createdAt', 'expiresAt', 'channelLabel'])
        && (!('channelLabel' in data)
            || (data.channelLabel is string && data.channelLabel.size() <= 256))
        && (
          (data.type in ['offer', 'answer']
            && data.payload.keys().hasOnly(['type', 'sdp'])
            && data.payload.type == data.type
            && data.payload.sdp is string
            && data.payload.sdp.size() <= 10 * 1024)
          ||
          (data.type == 'ice'
            && data.payload.keys().hasOnly(['candidate', 'sdpMid', 'sdpMLineIndex'])
            && data.payload.candidate is string
            && data.payload.candidate.size() <= 4096
            && (!('sdpMid' in data.payload)
                || data.payload.sdpMid == null
                || (data.payload.sdpMid is string && data.payload.sdpMid.size() <= 256))
            && (!('sdpMLineIndex' in data.payload)
                || data.payload.sdpMLineIndex == null
                || data.payload.sdpMLineIndex is int))
        );
    }

    // ── 參與者自行離開 ──────────────────────────────────────────────
    // leaveRoom 是把自己從 participants 移除，更新後 uid 必不在列表中，
    // 落不進「加入/更新身分」分支，需要獨立分支。
    // 限制：被移除的成員 ⊆ {自己} 且不得新增成員；只能動離開相關欄位；
    // meshIdentities 另受 meshIdentitiesChangeIsValid 限制（只能動自己的條目）。
    function isSelfLeaveOnly() {
      let oldP = resource.data.participants.toSet();
      let newP = request.resource.data.participants.toSet();
      return request.auth.uid in resource.data.participants
        && !(request.auth.uid in request.resource.data.participants)
        && oldP.difference(newP).hasOnly([request.auth.uid])
        && newP.difference(oldP).size() == 0
        && request.resource.data.participants.size() == newP.size()
        && participantCountMatches(request.resource.data)
        && ownerUidUnchanged()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
             ['participants', 'participantCount', 'lastActiveAt', 'ttlExpireAt', 'meshIdentities']);
    }

    // P2P Rooms collection
    // 安全規則：只允許已登入的用戶（非匿名）建立房間
    match /p2pRooms/{roomId} {
      // 讀取：允許已登入用戶讀取公開房間，或讀取自己參與的房間
      allow read: if isAuthenticated() && (
        // 公開房間（isPrivate 不存在時視為公開）
        !('isPrivate' in resource.data) || !resource.data.isPrivate ||
        // 或參與者列表包含當前用戶
        request.auth.uid in resource.data.participants ||
        // 或是房主
        request.auth.uid == resource.data.ownerUid
      );

      // 建立：只允許已登入的用戶（非匿名）建立房間
      // 且 ownerUid 必須是當前用戶
      allow create: if isAuthenticated() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == request.resource.data.participants.toSet().size() &&
        participantsWithinCap(request.resource.data) &&
        validMaxParticipantsOnCreate(request.resource.data) &&
        request.auth.token.firebase.sign_in_provider != "anonymous";

      // 更新按操作形狀授權，不能只看「更新後名冊含自己」；後者會讓陌生人先把
      // 自己塞進 participants，再於同一次 update 接管房間。
      // 任何更新都不得修改其他使用者的 meshIdentities 條目（防 MITM）。
      allow update: if isAuthenticated() && meshIdentitiesChangeIsValid() &&
        participantsWithinCap(request.resource.data) &&
        maxParticipantsUnchanged() && (
        isOwnerManagedUpdate() ||
        isOwnerMigration() ||
        (resource.data.status != 'closed' && isSelfJoinOnly()) ||
        // 參與者離開房間：把自己（且只有自己）從 participants 移除。
        // 必須排在 meshIdentity 分支之前：rules 的 || 由左至右短路且不吸收
        // 錯誤，後面分支若 evaluation error 會蓋掉這裡的 true。
        isSelfLeaveOnly() ||
        isParticipantActivityUpdate() ||
        isOwnMeshIdentityUpdate()
      );

      // 刪除：房主，或「全員軟刪除後的最後一人真刪」（RoomService.softDeleteRoom）。
      //
      // M-5：此前只要 `uid in participants` 即可刪整房。規則從未驗證軟刪除前提，
      // 而任何登入者都能自行加入公開房（isSelfJoinOnly）——等於任何人都能加入後
      // 把整間房連同全部訊息刪掉（破壞性 griefing）。
      //
      // 現在非房主必須「每位參與者都已軟刪除」。rules 沒有迴圈，無法對變動長度的
      // participants 逐一檢查，故精確支援雙人房（DM＝持久房的主要形態，也是這條
      // 路徑真正要服務的對象）；三人以上退回房主專屬。客戶端無須改動：
      // softDeleteRoom 的真刪已包在 try/catch，被拒時回報 'hidden'（房間對所有人
      // 都已隱藏），殘留文件由 ttlExpireAt 的原生 TTL 政策回收。
      function memberSoftDeleted(memberUid) {
        return exists(/databases/$(database)/documents/p2pRooms/$(roomId)/memberStates/$(memberUid))
          && get(/databases/$(database)/documents/p2pRooms/$(roomId)/memberStates/$(memberUid)).data.deletedAt != null;
      }
      function allMembersSoftDeleted() {
        return resource.data.participants.size() == 2
          && memberSoftDeleted(resource.data.participants[0])
          && memberSoftDeleted(resource.data.participants[1]);
      }
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.ownerUid ||
        (request.auth.uid in resource.data.participants && allMembersSoftDeleted())
      );

      // memberStates subcollection — 每位成員的個人狀態（已讀/釘選/軟刪除）
      // 文件 id = uid；只能寫自己的（防竄改他人已讀/刪除狀態），參與者可讀
      //（softDeleteRoom 需要讀全員狀態判斷是否全刪）。
      match /memberStates/{memberUid} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants;
        // 只能建立/更新自己的（防竄改他人已讀/釘選/刪除狀態）
        allow create, update: if isAuthenticated() &&
          request.auth.uid == memberUid &&
          request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants;
        // 刪除開放給參與者：全員軟刪除後的真刪除要連他人狀態文件一起清，
        // 否則留孤兒子文件（父文件刪除不會級聯）
        allow delete: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants;
      }

      // Signals subcollection - signaling 訊息
      // 安全措施：
      //   1. 只能建立自己的 signal（from === auth.uid）
      //   2. SDP 上限 10KB；ICE candidate 上限 4KB，且欄位採 allowlist
      //   3. append-only（不可更新/刪除）
      //   4. createdAt 型別有效、expiresAt 必須在未來 10 分鐘內
      match /signals/{signalId} {
        // 只有該房間的參與者（或房主）能讀取 signaling — 防止任意登入用戶
        // 爬取所有房間的 ICE 候選 / SDP 來建立使用者圖譜。
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants ||
          request.auth.uid == get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.ownerUid
        );
        allow create: if isAuthenticated()
          && (request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants
              || request.auth.uid == get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.ownerUid)
          && request.resource.data.from == request.auth.uid
          && request.resource.data.type in ['offer', 'answer', 'ice']
          // initiator 在收到第一個遠端 signal 前尚不知道 remoteUid，既有 WebRTC
          // handshake 會以 to:null 廣播初始 offer / ICE；answer 一定已有明確收件人。
          && ((request.resource.data.to is string
               && request.resource.data.to != request.auth.uid
               && (request.resource.data.to in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants
                   || request.resource.data.to == get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.ownerUid))
              || (request.resource.data.to == null
                  && request.resource.data.type in ['offer', 'ice']))
          && isValidSignalPayload(request.resource.data)
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(10, 'm')
          // createdAt 可為 number（客戶端 Date.now()）或 timestamp（serverTimestamp()）
          && (request.resource.data.createdAt is number || request.resource.data.createdAt is timestamp);
        allow update: if false;
        // 允許 signal 發送者刪除自己的 signal（連線建立後清理）
        // 或房間參與者刪除該房間的舊 signals（session cleanup）
        allow delete: if isAuthenticated()
          && resource.data.from == request.auth.uid;
      }

      // Messages subcollection - 備援聊天訊息（P2P 未連線時使用）
      // 允許參與者刪除（離開房間時清理個人訊息）
      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants;
        // 建立：必須是參與者、from 必須等於 auth.uid、且 createdAt 必須在
        // 30 秒內（防 replay）。createdAt 為 timestamp 或 number 皆可。
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/p2pRooms/$(roomId)).data.participants &&
          request.resource.data.from == request.auth.uid &&
          // M-4：文件大小上限。此前無限制，任何登入者可加入公開房後以逼近 1MiB 的
          // 文件連續寫入，燒掉專案的 Firestore 寫入與儲存配額（signals 有 10KB、
          // relayDirectory 有 4KB，唯獨 messages 漏了）。64KB 遠寬於正常文字訊息
          // （含 base64 密文膨脹），同時把單則濫用上界壓到 1/16。
          request.resource.size() < 64 * 1024 &&
          request.resource.data.expiresAt is timestamp &&
          request.resource.data.expiresAt > request.time &&
          request.resource.data.expiresAt <= request.time + duration.value(25, 'h') &&
          (
            (request.resource.data.createdAt is timestamp &&
             request.resource.data.createdAt > request.time - duration.value(30, 's') &&
             request.resource.data.createdAt < request.time + duration.value(30, 's')) ||
            (request.resource.data.createdAt is number &&
             request.resource.data.createdAt > (request.time.toMillis() - 30000) &&
             request.resource.data.createdAt < (request.time.toMillis() + 30000))
          );
        allow update: if false;
        allow delete: if isAuthenticated()
          && resource.data.from == request.auth.uid;
      }
    }

    // 好友關係（2026-07-05）：id = 排序後 uidA_uidB；只有當事雙方可讀寫。
    // 只有「受邀方」能把 pending 改 accepted（防單方面自我通過）。
    match /friendships/{fid} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.uids;
      allow create: if isAuthenticated() &&
        request.resource.data.uids.size() == 2 &&
        request.auth.uid in request.resource.data.uids &&
        request.resource.data.requestedBy == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        // M-2：文件 id 必須等於「排序後 uidA_uidB」。此前 create 允許任意 fid，
        // FriendService.pairId() 的確定性 id 只是客戶端慣例，規則並不強制——
        // 攻擊者可用隨機 id 對同一受害者建立無限筆 pending 邀請洪水（同時燒讀取配額）。
        // uids[0] < uids[1] 同時保證「已排序」與「兩者相異」（不能加自己為好友）。
        request.resource.data.uids[0] < request.resource.data.uids[1] &&
        fid == request.resource.data.uids[0] + '_' + request.resource.data.uids[1];
      allow update: if isAuthenticated() &&
        request.auth.uid in resource.data.uids &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        resource.data.requestedBy != request.auth.uid &&
        // M-1：欄位白名單。此前未限制 affectedKeys，「接受方」可在按下接受的同一次
        // 寫入裡改寫 uids/requestedBy/names/createdAt——把 uids 換成 [自己, 受害者]
        // 並自訂顯示名，受害者的好友頁就會冒出一位從未同意過的「已接受」好友
        // （直接的釣魚介面），且被塞入 uids 者連帶取得該文件讀取權。
        // 白名單＝FriendService.accept() 實際寫入的四個欄位。
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'acceptedAt', 'dmRoomId', 'names']) &&
        // names 只能改自己那一格（同 meshIdentitiesChangeIsValid 的既有做法）
        request.resource.data.names.diff(resource.data.names).affectedKeys()
          .hasOnly([request.auth.uid]);
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.uids;
    }

    // 全站節點名冊（ADR-0023 P4-A）：線上節點宣告可中繼/當盲信使，供陌生節點
    // 互相發現、建立站級 overlay。id = 宣告者的 auth.uid（一使用者/裝置一則）。
    // 隱私：宣告只含 nodeId + 粗略 metrics + regionHint，不含 IP。
    match /relayDirectory/{ownerUid} {
      // 讀：任何登入者可查名冊（發現候選節點）。
      allow read: if isAuthenticated();
      // 寫：只能寫自己那一則（防冒名/覆寫他人宣告 → 反女巫、防名冊污染）；非匿名才可
      // 宣告；announcedAt 需在 server 時間 ±60s（防灌陳舊/未來宣告佔位）；nodeId 格式限制。
      allow create, update: if isAuthenticated()
        && ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.nodeId is string
        && request.resource.data.nodeId.size() >= 8
        && request.resource.data.nodeId.size() <= 64
        && request.resource.data.announcedAt is number
        && request.resource.data.announcedAt > request.time.toMillis() - 60000
        && request.resource.data.announcedAt < request.time.toMillis() + 60000
        && request.resource.size() < 4 * 1024;
      // 撤回：只能撤自己。
      allow delete: if isAuthenticated() && ownerUid == request.auth.uid;
    }

    // 陌生節點站級 signaling（ADR-0023 P4-B）：非成員與成員在不綁房的 pairwise
    // 通道上交換 WebRTC signals，建 relay-only DataChannel（盲信使補齊的傳輸）。
    // channelId = 雙方 uid 排序後串接。只有通道 participants 內兩人能讀寫。
    match /relaySignals/{channelId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      // 開通道：必須是雙方之一、participants 恰好 2 人、非匿名（反女巫）。
      allow create: if isAuthenticated()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        // H-3：文件 id 必須等於 relayChannelId(participants)＝排序後以 '__' 串接。
        // 此前註解宣稱有這個不變量，規則卻未強制：攻擊者可用任意 id 對同一受害者
        // 開無限條通道，每條都讓受害者自動應答一次 WebRTC 協商（藉 ICE candidate
        // 取得對方 IP，並耗盡其 RTCPeerConnection 資源）。綁定後一對 uid 只有一條通道。
        // participants[0] < participants[1] 同時保證已排序與兩者相異。
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        && channelId == request.resource.data.participants[0] + '__' + request.resource.data.participants[1]
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm')
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
      // 更新（ensureChannel merge 續期）：participants 不得變更。
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');
      allow delete: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // signals 子集合：append-only 的 offer/answer/ice。
      match /signals/{signalId} {
        function chanParticipants() {
          return get(/databases/$(database)/documents/relaySignals/$(channelId)).data.participants;
        }
        allow read: if isAuthenticated() && request.auth.uid in chanParticipants();
        allow create: if isAuthenticated()
          && request.auth.uid in chanParticipants()
          && request.resource.data.from == request.auth.uid
          && request.resource.data.type in ['offer', 'answer', 'ice']
          && request.resource.size() < 10 * 1024
          && request.resource.data.expiresAt is timestamp
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(10, 'm')
          && (request.resource.data.createdAt is number || request.resource.data.createdAt is timestamp);
        allow update: if false; // append-only
        allow delete: if isAuthenticated() && resource.data.from == request.auth.uid;
      }
    }

    // 明確禁止其他集合儲存敏感內容
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
