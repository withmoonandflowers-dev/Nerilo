# Vue candidate preview configuration.
# Copy to .env.preview and replace every REPLACE_ME_* value with credentials
# from the isolated nerilo-staging Firebase project.

VITE_FIREBASE_API_KEY=REPLACE_ME_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=nerilo-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nerilo-staging
VITE_FIREBASE_STORAGE_BUCKET=nerilo-staging.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REPLACE_ME_SENDER_ID
VITE_FIREBASE_APP_ID=REPLACE_ME_APP_ID

VITE_DEPLOY_ENV=preview
VITE_USE_EMULATOR=false

# Optional preview-only integrations. Do not put a production checkout URL here.
VITE_LS_CHECKOUT_URL=
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_TURN_CREDENTIAL_ENDPOINT=
VITE_SENTRY_DSN=
VITE_APPCHECK_KEY=
VITE_TELEMETRY_ENDPOINT=
